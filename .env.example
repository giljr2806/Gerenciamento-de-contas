# Copie para .env.local (local) e cadastre as MESMAS variaveis no painel da Vercel.
# NUNCA commite .env.local.

# --- Seguranca do app (servidor) ---
# Chave do perfil Desenvolvedor. Se vazia, o 1o desenvolvedor define a chave no app.
DEVELOPER_ACCESS_CODE=
# Segredo (>= 32 chars) que assina a sessao elevada do desenvolvedor.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# E-mail do primeiro usuario Desenvolvedor (usado quando o banco esta vazio)
BOOTSTRAP_DEVELOPER_EMAIL=
APP_URL="http://localhost:3000"

# --- Firebase (cliente, publico por design) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin (servidor, SECRETO) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GEMINI_API_KEY=
